{
  "name": "napster-cdnow-2001-02",
  "title": "napster.cdnow.com, 23 February 2001",
  "mode": "forward",
  "_mode": "No archived bytes live in this repository; this is forwarded from the Internet Archive like every other exhibit.",
  "why": "The client's top-right banner reads 'Shop for music at CDNOW'. The binary holds that menu string but no URL at all -- every URL in napster.exe is a napster.com one. Driving the live client under a WinINet proxy showed the button requests http://shop.napster.com/, which in the era answered 302 to this co-branded CDNOW subdomain. So the button never pointed at cdnow.com directly; it pointed at a first-party redirector carrying an affiliate tag (visible in the archive as 'from=sr-5274506').",
  "source": "https://web.archive.org/web/20010223213245/http://napster.cdnow.com/",
  "snapshot": "20010223213245",
  "upstream": {
    "template": "https://web.archive.org/web/{snapshot}{modifier}/{url}",
    "modifier": {
      "text": "id_",
      "binary": "im_"
    },
    "hosts": [
      "napster.cdnow.com",
      "gs.cdnow.com"
    ]
  },
  "default_host": "napster.cdnow.com",
  "reached_via": {
    "shop.napster.com": "302 -> http://napster.cdnow.com/, as it answered in the era. Mounted as a redirect rather than serving this page under that name: it is what actually happened, and serving directly was tried and gained nothing."
  },
  "dating": "The earliest archived 302 for shop.napster.com is 2001-02-20; the earliest 200 for napster.cdnow.com is 2001-02-23. Both are within six weeks of this client's build date (2001-01-10), so this is close to what its button actually reached. There is no capture of either host from 2000, which is why the March 2000 exhibit has no contemporaneous shop page.",
